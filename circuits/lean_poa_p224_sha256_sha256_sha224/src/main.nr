//! lean_poa_p224_sha256_sha256_sha224: passport register circuit for ECDSA P-224 (zkpassport/noir-ecdsa).
//! Hashes: data groups SHA-256, eContent SHA-256, signature SHA-224.
//!
//! Generated by circuits/tools/variants.py from circuits/variants.json; do not
//! edit. Everything but the signature check is poa_core.
//!
//! Public input order: current_date, address, then the public return values
//! (nullifier, dsc_key).

use bignum::BigNum;
use bignum::fields::secp224r1Fq::Secp224r1_Fq;
use bignum::fields::secp224r1Fr::Secp224r1_Fr;
use ecdsa::ecdsa::verify_secp224r1_ecdsa;
use poa_core::hash;

mod vectors;

fn main(
    dg1: [u8; 95],
    dg1_len: u32,
    e_content: [u8; 695],
    e_content_len: u32,
    dg1_hash_offset: u32,
    signed_attrs: [u8; 256],
    signed_attrs_len: u32,
    econtent_hash_offset: u32,
    dsc_pubkey_x: [u8; 28],
    dsc_pubkey_y: [u8; 28],
    sod_signature_r: [u8; 28],
    sod_signature_s: [u8; 28], // low
    current_date: pub u32,
    address: pub Field,
) -> pub (Field, Field) {
    let digest = poa_core::hash_and_bind(
        dg1,
        dg1_len,
        e_content,
        e_content_len,
        dg1_hash_offset,
        signed_attrs,
        signed_attrs_len,
        econtent_hash_offset,
        hash::sha256,
        hash::sha256,
        hash::sha224,
    );
    let x: Secp224r1_Fq = Secp224r1_Fq::from_be_bytes(dsc_pubkey_x);
    let y: Secp224r1_Fq = Secp224r1_Fq::from_be_bytes(dsc_pubkey_y);
    let r: Secp224r1_Fr = Secp224r1_Fr::from_be_bytes(sod_signature_r);
    let s: Secp224r1_Fr = Secp224r1_Fr::from_be_bytes(sod_signature_s);
    assert(verify_secp224r1_ecdsa(x, y, digest, (r, s)));

    let mut key: [u8; 56] = [0; 56];
    for i in 0..28 {
        key[i] = dsc_pubkey_x[i];
        key[28 + i] = dsc_pubkey_y[i];
    }
    let commitment = poa_core::dsc_commitment(poa_core::CURVE_TAG_P224, key);
    poa_core::finalize(dg1, commitment, current_date, address)
}
