<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/white"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="From"
            android:textSize="14sp"
            android:textColor="@color/text_secondary"
            android:layout_marginBottom="6dp" />

        <Spinner
            android:id="@+id/redelegate_from_spinner"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@drawable/input_background"
            android:layout_marginBottom="16dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="To"
            android:textSize="14sp"
            android:textColor="@color/text_secondary"
            android:layout_marginBottom="6dp" />

        <Spinner
            android:id="@+id/redelegate_to_spinner"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@drawable/input_background"
            android:layout_marginBottom="16dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="8dp">

            <TextView
                android:id="@+id/redelegate_available_label"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Available: 0"
                android:textSize="14sp"
                android:textColor="@color/text_secondary" />

            <Button
                android:id="@+id/redelegate_max_button"
                android:layout_width="wrap_content"
                android:layout_height="28dp"
                android:background="@drawable/btn_accent_modern"
                app:backgroundTint="@null"
                android:elevation="0dp"
                android:stateListAnimator="@null"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:paddingLeft="10dp"
                android:paddingRight="10dp"
                android:text="Max"
                android:textAllCaps="false"
                android:textColor="@android:color/white"
                android:textSize="12sp" />
        </LinearLayout>

        <EditText
            android:id="@+id/redelegate_amount_input"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:background="@drawable/input_background"
            android:hint="0.0"
            android:inputType="numberDecimal"
            android:paddingLeft="16dp"
            android:paddingRight="16dp"
            android:textSize="16sp"
            android:layout_marginBottom="16dp" />

        <Button
            android:id="@+id/redelegate_button"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:background="@drawable/btn_accent_modern"
            app:backgroundTint="@null"
            android:elevation="0dp"
            android:stateListAnimator="@null"
            android:text="Redelegate"
            android:textAllCaps="false"
            android:textColor="@android:color/white"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/redelegate_note"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Stake keeps earning — there is no unbonding gap. It stays locked until it matures: it cannot be moved again, and it is still slashable for the source validator's faults."
            android:textSize="12sp"
            android:textColor="@color/text_secondary"
            android:layout_marginTop="12dp" />
    </LinearLayout>
</ScrollView>
