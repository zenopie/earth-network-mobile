# Android/Gradle/IDE gitignore
# (Android build lives in android/, iOS in ios/; most rules below are
#  unanchored and so keep matching at any depth after the split.)

# Built application files
*.apk
*.aar
*.ap_
*.aab

# ART/Dalvik VM files
*.dex

# Java/Kotlin class files
*.class

# Generated directories
bin/
gen/
out/

# Gradle
.gradle/
build/
**/build/

# Local configuration (SDK path, etc.)
local.properties

# Android Studio/IntelliJ IDEA
.idea/
*.iml

# Android NDK / CMake
.externalNativeBuild/
.cxx/

# Android Studio artifacts
captures/
.navigation/

# Logs and profiling
*.log
*.hprof
*.trace

# Keystores and signing configs (DO NOT COMMIT SECRETS)
*.jks
*.keystore
keystore.properties
*.keystore.properties
signing.properties

# OS junk
.DS_Store
Thumbs.db

# VS Code
.vscode/

# Misc local env/config files
*.local
.env
.env.*

# Cache directories
.gradletasknamecache

# Keep Gradle wrapper in VCS (do not ignore these)
!gradlew
!gradlew.bat
!gradle/wrapper/gradle-wrapper.jar
!gradle/wrapper/gradle-wrapper.properties
!gradle/wrapper/

# Ignore lint/analysis reports if not under build (most are in build already)
lint-results.*

# Android build outputs often placed under module dirs; already covered by **/build/
# Loose .class files from an extracted jar used to sit in the repo root
# (io/, org/, META-INF/) — left over from the Secret Network dependency and
# invisible to git status because of the *.class rule above. Removed; the rule
# stays so it cannot happen again silently.

# --- iOS / Swift ---

# SwiftPM
.build/
.swiftpm/
Packages/
# Package.resolved is kept: the bb version lockstep with Android and the chain
# depends on resolving to exactly one Swoirenberg build.
!Package.resolved

# Xcode
DerivedData/
xcuserdata/
*.xcuserstate
*.xcscmblueprint
*.moved-aside

# Proof/VK artifacts emitted by the Phase 1 gate test, and the transaction
# fixture corecheck writes for tools/txcheck
ios/ProverGate/.artifacts/
ios/EarthCore/.artifacts/

# CocoaPods / Carthage, if they ever appear
Pods/
Carthage/Build/

# Fastlane
fastlane/report.xml
fastlane/screenshots/
fastlane/test_output/
# End
