//! lean_poa_p521_sha512: passport register circuit for ECDSA P-521 (zkpassport/noir-ecdsa).
//! Hashes: data groups SHA-512, eContent SHA-512, signature SHA-512.
//!
//! Generated by circuits/tools/variants.py from circuits/variants.json; do not
//! edit. Everything but the signature check is poa_core.
//!
//! Public input order: current_date, address, then the public return values
//! (nullifier, dsc_key).

use bignum::BigNum;
use bignum::fields::secp521r1Fq::Secp521r1_Fq;
use bignum::fields::secp521r1Fr::Secp521r1_Fr;
use ecdsa::ecdsa::verify_secp521r1_ecdsa;
use poa_core::hash;

mod vectors;

fn main(
    dg1: [u8; 95],
    dg1_len: u32,
    e_content: [u8; 751],
    e_content_len: u32,
    dg1_hash_offset: u32,
    signed_attrs: [u8; 239],
    signed_attrs_len: u32,
    econtent_hash_offset: u32,
    dsc_pubkey_x: [u8; 66],
    dsc_pubkey_y: [u8; 66],
    sod_signature_r: [u8; 66],
    sod_signature_s: [u8; 66], // low
    current_date: pub u32,
    address: pub Field,
) -> pub (Field, Field) {
    let digest = poa_core::hash_and_bind(
        dg1,
        dg1_len,
        e_content,
        e_content_len,
        dg1_hash_offset,
        signed_attrs,
        signed_attrs_len,
        econtent_hash_offset,
        hash::sha512,
        hash::sha512,
        hash::sha512,
    );
    let x: Secp521r1_Fq = Secp521r1_Fq::from_be_bytes(dsc_pubkey_x);
    let y: Secp521r1_Fq = Secp521r1_Fq::from_be_bytes(dsc_pubkey_y);
    let r: Secp521r1_Fr = Secp521r1_Fr::from_be_bytes(sod_signature_r);
    let s: Secp521r1_Fr = Secp521r1_Fr::from_be_bytes(sod_signature_s);
    assert(verify_secp521r1_ecdsa(x, y, digest, (r, s)));

    let mut key: [u8; 132] = [0; 132];
    for i in 0..66 {
        key[i] = dsc_pubkey_x[i];
        key[66 + i] = dsc_pubkey_y[i];
    }
    let commitment = poa_core::dsc_commitment(poa_core::CURVE_TAG_P521, key);
    poa_core::finalize(dg1, commitment, current_date, address)
}
