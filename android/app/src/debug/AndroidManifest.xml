<?xml version="1.0" encoding="utf-8"?>
<!--
    Debug-only additions, merged into the main manifest for debug builds and
    absent from release.

    The design-system gallery lives here rather than in the main manifest. It
    has to be exported to be useful — `adb shell am start` runs as the shell
    uid, and a non-exported activity refuses that with a permission denial — but
    an exported activity is one any installed app can launch, and a component
    that exists only for development should not be reachable in a shipped
    wallet at all. Declaring it here gives both: launchable during development,
    not present in the release manifest.

    ShowcaseActivity.kt itself stays in src/main, so it still typechecks with
    the rest of the UI. It is simply never declared in a release build.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application>
        <activity
            android:name=".ui.compose.ShowcaseActivity"
            android:exported="true"
            android:theme="@style/Theme.AppCompat.NoActionBar" />
    </application>

</manifest>
