#[test]
fn accepts_its_fixture() {
    let (nullifier, dsc_key) = crate::main(DG1, DG1_LEN, E_CONTENT, E_CONTENT_LEN, DG1_HASH_OFFSET, SIGNED_ATTRS, SIGNED_ATTRS_LEN, ECONTENT_HASH_OFFSET, DSC_MODULUS, DSC_REDC, SOD_SIGNATURE, DSC_EXPONENT, PSS_SALT_LEN, CURRENT_DATE, ADDRESS);
    assert(nullifier == NULLIFIER);
    assert(dsc_key == DSC_KEY);
}

#[test(should_fail)]
fn rejects_a_tampered_dg1() {
    let mut dg1 = DG1;
    dg1[60] = dg1[60] ^ 1;
    let _ = crate::main(dg1, DG1_LEN, E_CONTENT, E_CONTENT_LEN, DG1_HASH_OFFSET, SIGNED_ATTRS, SIGNED_ATTRS_LEN, ECONTENT_HASH_OFFSET, DSC_MODULUS, DSC_REDC, SOD_SIGNATURE, DSC_EXPONENT, PSS_SALT_LEN, CURRENT_DATE, ADDRESS);
}

#[test(should_fail)]
fn rejects_a_tampered_signature() {
    let mut sig = SOD_SIGNATURE;
    sig[0] = sig[0] ^ 1;
    let _ = crate::main(DG1, DG1_LEN, E_CONTENT, E_CONTENT_LEN, DG1_HASH_OFFSET, SIGNED_ATTRS, SIGNED_ATTRS_LEN, ECONTENT_HASH_OFFSET, DSC_MODULUS, DSC_REDC, sig, DSC_EXPONENT, PSS_SALT_LEN, CURRENT_DATE, ADDRESS);
}

#[test(should_fail)]
fn rejects_a_signature_under_another_hash() {
    let _ = crate::main(DG1, DG1_LEN, E_CONTENT, E_CONTENT_LEN, DG1_HASH_OFFSET, SIGNED_ATTRS, SIGNED_ATTRS_LEN, ECONTENT_HASH_OFFSET, DSC_MODULUS, DSC_REDC, SIG_OTHER_HASH, DSC_EXPONENT, PSS_SALT_LEN, CURRENT_DATE, ADDRESS);
}

#[test(should_fail)]
fn rejects_the_other_padding() {
    let _ = crate::main(DG1, DG1_LEN, E_CONTENT, E_CONTENT_LEN, DG1_HASH_OFFSET, SIGNED_ATTRS, SIGNED_ATTRS_LEN, ECONTENT_HASH_OFFSET, DSC_MODULUS, DSC_REDC, SIG_OTHER_PADDING, DSC_EXPONENT, PSS_SALT_LEN, CURRENT_DATE, ADDRESS);
}
