<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- HTTPS only. Debug builds add cleartext to a local LCD
         (src/debug/res/xml); a release build never has it, so no endpoint
         left pointing at loopback can be served by another app on the device. -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system"/>
        </trust-anchors>
    </base-config>
</network-security-config>
