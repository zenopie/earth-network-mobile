//! lean_poa_bp224_sha1: passport register circuit for ECDSA brainpoolP224r1 (zkpassport/noir-ecdsa).
//! Hashes: data groups SHA-1, eContent SHA-1, signature SHA-1.
//!
//! Generated by circuits/tools/variants.py from circuits/variants.json; do not
//! edit. Everything but the signature check is poa_core.
//!
//! Public input order: current_date, address, then the public return values
//! (nullifier, dsc_key, idc). idc = H(TAG_ID, id_secret) is computed from the
//! prover's private id_secret, so a passport registers only to an identity
//! whose secret its prover holds.

use bignum::BigNum;
use bignum::fields::brainpoolP224r1Fq::BrainpoolP224r1_Fq;
use bignum::fields::brainpoolP224r1Fr::BrainpoolP224r1_Fr;
use ecdsa::ecdsa::verify_brainpoolp224r1_ecdsa;
use poa_core::hash;

mod vectors;

fn main(
    dg1: [u8; 95],
    dg1_len: u32,
    e_content: [u8; 439],
    e_content_len: u32,
    dg1_hash_offset: u32,
    signed_attrs: [u8; 247],
    signed_attrs_len: u32,
    econtent_hash_offset: u32,
    dsc_pubkey_x: [u8; 28],
    dsc_pubkey_y: [u8; 28],
    sod_signature_r: [u8; 28],
    sod_signature_s: [u8; 28], // low
    id_secret: Field,
    current_date: pub u32,
    address: pub Field,
) -> pub (Field, Field, Field) {
    let digest = poa_core::hash_and_bind(
        dg1,
        dg1_len,
        e_content,
        e_content_len,
        dg1_hash_offset,
        signed_attrs,
        signed_attrs_len,
        econtent_hash_offset,
        hash::sha1,
        hash::sha1,
        hash::sha1,
    );
    let x: BrainpoolP224r1_Fq = BrainpoolP224r1_Fq::from_be_bytes(dsc_pubkey_x);
    let y: BrainpoolP224r1_Fq = BrainpoolP224r1_Fq::from_be_bytes(dsc_pubkey_y);
    let r: BrainpoolP224r1_Fr = BrainpoolP224r1_Fr::from_be_bytes(sod_signature_r);
    let s: BrainpoolP224r1_Fr = BrainpoolP224r1_Fr::from_be_bytes(sod_signature_s);
    assert(verify_brainpoolp224r1_ecdsa(x, y, digest, (r, s)));

    let mut key: [u8; 56] = [0; 56];
    for i in 0..28 {
        key[i] = dsc_pubkey_x[i];
        key[28 + i] = dsc_pubkey_y[i];
    }
    let commitment = poa_core::dsc_commitment(poa_core::CURVE_TAG_BRAINPOOL_P224R1, key);
    poa_core::finalize(dg1, commitment, current_date, address, id_secret)
}
