<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Window theme. The screens themselves are Compose and draw their own
         colours; this covers the window, status bar and UpdateCheckActivity. -->
    <style name="Theme.EarthWallet" parent="Theme.MaterialComponents.Light.NoActionBar">
        <item name="colorPrimary">#4caf50</item>
        <item name="colorPrimaryVariant">#388e3c</item>
        <item name="colorOnPrimary">@android:color/white</item>
        <item name="colorSecondary">#FF9800</item>
        <item name="colorSecondaryVariant">#F57C00</item>
        <item name="colorOnSecondary">@android:color/black</item>
        <item name="android:statusBarColor" tools:targetApi="l">@android:color/white</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowBackground">@android:color/white</item>
        <item name="windowActionBar">false</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:fitsSystemWindows">true</item>
    </style>
</resources>
