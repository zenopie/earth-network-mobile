<?xml version="1.0" encoding="utf-8"?>
<!--
  Nothing leaves the device, by cloud backup or by phone-to-phone transfer.

  allowBackup="false" covers cloud backup, but from Android 12 it does not stop
  device-to-device transfer: that reads these rules instead, and with none the
  wallet's preferences and files went across. The encrypted wallet is useless
  without this device's Keystore, but the unlock-attempt counter, the biometric
  slot pointer and the wallet list are not, and a new phone should start from
  the recovery phrase.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
