<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Window theme. The screens themselves are Compose and draw their own
         colours; this covers the window, status bar and UpdateCheckActivity. -->
    <style name="Theme.EarthWallet" parent="Theme.MaterialComponents.Light.NoActionBar">
        <item name="colorPrimary">#4caf50</item>
        <item name="colorPrimaryVariant">#388e3c</item>
        <item name="colorOnPrimary">@android:color/white</item>
        <item name="colorSecondary">#FF9800</item>
        <item name="colorSecondaryVariant">#F57C00</item>
        <item name="colorOnSecondary">@android:color/black</item>
        <item name="android:statusBarColor" tools:targetApi="l">@android:color/white</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowBackground">@android:color/white</item>
        <item name="windowActionBar">false</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:fitsSystemWindows">true</item>
    </style>

    <!--
      Applied at runtime to the Material ModalBottomSheet's own dialog window (see
      EarthScreenModalBottomSheet). Slide-down exit only; opening uses Material's in-Compose
      slide-up so we must not double-animate the enter.
    -->
    <style name="EarthBottomSheetDialogAnimation">
        <item name="android:windowExitAnimation">@anim/sheet_slide_out_bottom</item>
    </style>

    <!--
      Applied at runtime to the host window that carries the bottom-sheet dim. Fades the dim
      out in place when the dialog is dismissed, so the dim never slides with the sheet.
    -->
    <style name="EarthBottomSheetScrimAnimation">
        <item name="android:windowExitAnimation">@anim/scrim_fade_out</item>
    </style>
</resources>
