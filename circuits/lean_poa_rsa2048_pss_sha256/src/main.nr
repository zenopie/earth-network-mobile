//! lean_poa_rsa2048_pss_sha256: passport register circuit for RSA-2048 PSS, any exponent in [3, 2^17).
//! Hashes: data groups SHA-256, eContent SHA-256, signature SHA-256.
//!
//! Generated by circuits/tools/variants.py from circuits/variants.json; do not
//! edit. Everything but the signature check is poa_core.
//!
//! Public input order: current_date, address, then the public return values
//! (nullifier, dsc_key, idc). idc = H(TAG_ID, id_secret) is computed from the
//! prover's private id_secret, so a passport registers only to an identity
//! whose secret its prover holds.

use bignum::params::BigNumParams;
use bignum::RuntimeBigNum;
use rsa::pss::verify_sha256_pss;
use poa_core::hash;

mod vectors;

fn main(
    dg1: [u8; 95],
    dg1_len: u32,
    e_content: [u8; 695],
    e_content_len: u32,
    dg1_hash_offset: u32,
    signed_attrs: [u8; 256],
    signed_attrs_len: u32,
    econtent_hash_offset: u32,
    dsc_modulus: [u128; 18], // modulus, noir-bignum 120-bit limbs
    dsc_redc: [u128; 18], // Barrett parameter (unconstrained use only)
    sod_signature: [u128; 18],
    dsc_exponent: u32,
    pss_salt_len: u32,
    id_secret: Field,
    current_date: pub u32,
    address: pub Field,
) -> pub (Field, Field, Field) {
    let digest = poa_core::hash_and_bind(
        dg1,
        dg1_len,
        e_content,
        e_content_len,
        dg1_hash_offset,
        signed_attrs,
        signed_attrs_len,
        econtent_hash_offset,
        hash::sha256,
        hash::sha256,
        hash::sha256,
    );
    let params: BigNumParams<18, 2048> = BigNumParams::new(false, dsc_modulus, dsc_redc);
    let signature: RuntimeBigNum<18, 2048> = RuntimeBigNum::from_array(params, sod_signature);
    assert(verify_sha256_pss(digest, signature, dsc_exponent, pss_salt_len));

    let modulus: [u8; 256] = poa_core::modulus_be_bytes(dsc_modulus);
    let commitment = poa_core::dsc_commitment_rsa(dsc_exponent, modulus);
    poa_core::finalize(dg1, commitment, current_date, address, id_secret)
}
