//! The five hashes ICAO passports use, behind one signature:
//! `(msg: [u8; N], len: u32) -> digest`, hashing the first `len` bytes.
//!
//! SHA-1 is accepted on purpose (PASSPORT_COVERAGE.md section 5): every byte it
//! hashes here is issuer-formed, so a forgery needs a second preimage, not a
//! collision.

// The SHA-1 and SHA-384/512 libraries read a BoundedVec's whole storage when
// they pad the last block, and `BoundedVec::from_parts` (nargo 1.0.0-beta.22)
// does not clear what lies past the length: junk there changes the digest.
// That is a wrong answer, not a forgery (matching a signed digest would still
// need a preimage), but the hashes must mean exactly "the first len bytes", so
// the tail is zeroed here, in-circuit.
fn prefix<let N: u32>(msg: [u8; N], len: u32) -> BoundedVec<u8, N> {
    assert(len <= N);
    let mut m = msg;
    for i in 0..N {
        if i >= len {
            m[i] = 0;
        }
    }
    BoundedVec::from_parts(m, len)
}

pub fn sha1<let N: u32>(msg: [u8; N], len: u32) -> [u8; 20] {
    ::sha1::sha1::sha1_var(prefix(msg, len))
}

pub fn sha224<let N: u32>(msg: [u8; N], len: u32) -> [u8; 28] {
    ::sha256::sha224_var(msg, len)
}

pub fn sha256<let N: u32>(msg: [u8; N], len: u32) -> [u8; 32] {
    ::sha256::sha256_var(msg, len)
}

pub fn sha384<let N: u32>(msg: [u8; N], len: u32) -> [u8; 48] {
    ::sha512::sha384::sha384_var(prefix(msg, len))
}

pub fn sha512<let N: u32>(msg: [u8; N], len: u32) -> [u8; 64] {
    ::sha512::sha512::sha512_var(prefix(msg, len))
}

// FIPS 180-4 / NIST CAVP short-message vectors ("abc" and the two-block
// message), and the zero-length message, for each hash through the same
// variable-length path the circuits use, with the message padded by junk
// past its length.

global ABC: [u8; 3] = [0x61, 0x62, 0x63];
global TWO_BLOCK: [u8; 56] = [
    0x61, 0x62, 0x63, 0x64, 0x62, 0x63, 0x64, 0x65, 0x63, 0x64, 0x65, 0x66, 0x64, 0x65, 0x66, 0x67,
    0x65, 0x66, 0x67, 0x68, 0x66, 0x67, 0x68, 0x69, 0x67, 0x68, 0x69, 0x6a, 0x68, 0x69, 0x6a, 0x6b,
    0x69, 0x6a, 0x6b, 0x6c, 0x6a, 0x6b, 0x6c, 0x6d, 0x6b, 0x6c, 0x6d, 0x6e, 0x6c, 0x6d, 0x6e, 0x6f,
    0x6d, 0x6e, 0x6f, 0x70, 0x6e, 0x6f, 0x70, 0x71,
];

fn padded<let M: u32>(m: [u8; M]) -> [u8; 200] {
    let mut out: [u8; 200] = [0xA5; 200];
    for i in 0..M {
        out[i] = m[i];
    }
    out
}

#[test]
fn sha1_vectors() {
    assert(sha1(padded(ABC), 3) == [
        0xa9, 0x99, 0x3e, 0x36, 0x47, 0x06, 0x81, 0x6a, 0xba, 0x3e, 0x25, 0x71, 0x78, 0x50, 0xc2, 0x6c,
        0x9c, 0xd0, 0xd8, 0x9d,
    ]);
    assert(sha1(padded(TWO_BLOCK), 56) == [
        0x84, 0x98, 0x3e, 0x44, 0x1c, 0x3b, 0xd2, 0x6e, 0xba, 0xae, 0x4a, 0xa1, 0xf9, 0x51, 0x29, 0xe5,
        0xe5, 0x46, 0x70, 0xf1,
    ]);
    assert(sha1(padded(ABC), 0) == [
        0xda, 0x39, 0xa3, 0xee, 0x5e, 0x6b, 0x4b, 0x0d, 0x32, 0x55, 0xbf, 0xef, 0x95, 0x60, 0x18, 0x90,
        0xaf, 0xd8, 0x07, 0x09,
    ]);
}

#[test]
fn sha224_vectors() {
    assert(sha224(padded(ABC), 3) == [
        0x23, 0x09, 0x7d, 0x22, 0x34, 0x05, 0xd8, 0x22, 0x86, 0x42, 0xa4, 0x77, 0xbd, 0xa2, 0x55, 0xb3,
        0x2a, 0xad, 0xbc, 0xe4, 0xbd, 0xa0, 0xb3, 0xf7, 0xe3, 0x6c, 0x9d, 0xa7,
    ]);
    assert(sha224(padded(TWO_BLOCK), 56) == [
        0x75, 0x38, 0x8b, 0x16, 0x51, 0x27, 0x76, 0xcc, 0x5d, 0xba, 0x5d, 0xa1, 0xfd, 0x89, 0x01, 0x50,
        0xb0, 0xc6, 0x45, 0x5c, 0xb4, 0xf5, 0x8b, 0x19, 0x52, 0x52, 0x25, 0x25,
    ]);
}

#[test]
fn sha256_vectors() {
    assert(sha256(padded(ABC), 3) == [
        0xba, 0x78, 0x16, 0xbf, 0x8f, 0x01, 0xcf, 0xea, 0x41, 0x41, 0x40, 0xde, 0x5d, 0xae, 0x22, 0x23,
        0xb0, 0x03, 0x61, 0xa3, 0x96, 0x17, 0x7a, 0x9c, 0xb4, 0x10, 0xff, 0x61, 0xf2, 0x00, 0x15, 0xad,
    ]);
    assert(sha256(padded(TWO_BLOCK), 56) == [
        0x24, 0x8d, 0x6a, 0x61, 0xd2, 0x06, 0x38, 0xb8, 0xe5, 0xc0, 0x26, 0x93, 0x0c, 0x3e, 0x60, 0x39,
        0xa3, 0x3c, 0xe4, 0x59, 0x64, 0xff, 0x21, 0x67, 0xf6, 0xec, 0xed, 0xd4, 0x19, 0xdb, 0x06, 0xc1,
    ]);
}

#[test]
fn sha384_vectors() {
    assert(sha384(padded(ABC), 3) == [
        0xcb, 0x00, 0x75, 0x3f, 0x45, 0xa3, 0x5e, 0x8b, 0xb5, 0xa0, 0x3d, 0x69, 0x9a, 0xc6, 0x50, 0x07,
        0x27, 0x2c, 0x32, 0xab, 0x0e, 0xde, 0xd1, 0x63, 0x1a, 0x8b, 0x60, 0x5a, 0x43, 0xff, 0x5b, 0xed,
        0x80, 0x86, 0x07, 0x2b, 0xa1, 0xe7, 0xcc, 0x23, 0x58, 0xba, 0xec, 0xa1, 0x34, 0xc8, 0x25, 0xa7,
    ]);
    assert(sha384(padded(TWO_BLOCK), 56) == [
        0x33, 0x91, 0xfd, 0xdd, 0xfc, 0x8d, 0xc7, 0x39, 0x37, 0x07, 0xa6, 0x5b, 0x1b, 0x47, 0x09, 0x39,
        0x7c, 0xf8, 0xb1, 0xd1, 0x62, 0xaf, 0x05, 0xab, 0xfe, 0x8f, 0x45, 0x0d, 0xe5, 0xf3, 0x6b, 0xc6,
        0xb0, 0x45, 0x5a, 0x85, 0x20, 0xbc, 0x4e, 0x6f, 0x5f, 0xe9, 0x5b, 0x1f, 0xe3, 0xc8, 0x45, 0x2b,
    ]);
}

#[test]
fn sha512_vectors() {
    assert(sha512(padded(ABC), 3) == [
        0xdd, 0xaf, 0x35, 0xa1, 0x93, 0x61, 0x7a, 0xba, 0xcc, 0x41, 0x73, 0x49, 0xae, 0x20, 0x41, 0x31,
        0x12, 0xe6, 0xfa, 0x4e, 0x89, 0xa9, 0x7e, 0xa2, 0x0a, 0x9e, 0xee, 0xe6, 0x4b, 0x55, 0xd3, 0x9a,
        0x21, 0x92, 0x99, 0x2a, 0x27, 0x4f, 0xc1, 0xa8, 0x36, 0xba, 0x3c, 0x23, 0xa3, 0xfe, 0xeb, 0xbd,
        0x45, 0x4d, 0x44, 0x23, 0x64, 0x3c, 0xe8, 0x0e, 0x2a, 0x9a, 0xc9, 0x4f, 0xa5, 0x4c, 0xa4, 0x9f,
    ]);
    assert(sha512(padded(TWO_BLOCK), 56) == [
        0x20, 0x4a, 0x8f, 0xc6, 0xdd, 0xa8, 0x2f, 0x0a, 0x0c, 0xed, 0x7b, 0xeb, 0x8e, 0x08, 0xa4, 0x16,
        0x57, 0xc1, 0x6e, 0xf4, 0x68, 0xb2, 0x28, 0xa8, 0x27, 0x9b, 0xe3, 0x31, 0xa7, 0x03, 0xc3, 0x35,
        0x96, 0xfd, 0x15, 0xc1, 0x3b, 0x1b, 0x07, 0xf9, 0xaa, 0x1d, 0x3b, 0xea, 0x57, 0x78, 0x9c, 0xa0,
        0x31, 0xad, 0x85, 0xc7, 0xa7, 0x1d, 0xd7, 0x03, 0x54, 0xec, 0x63, 0x12, 0x38, 0xca, 0x34, 0x45,
    ]);
}
