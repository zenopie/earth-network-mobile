<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Cleartext is not refused here but in code (chain/NodeConfig, EarthRest):
         every built-in endpoint is https, and the only http:// the app will
         open is the user's own node at a loopback or private-network address,
         chosen in Settings -> Network with a warning. This file cannot name a
         LAN address range, so it cannot draw that line itself. -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system"/>
        </trust-anchors>
    </base-config>
</network-security-config>
