<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- NFC: reading the passport chip. -->
    <uses-permission android:name="android.permission.NFC" />
    <uses-feature
        android:name="android.hardware.nfc"
        android:required="true" />

    
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Camera: scanning the passport MRZ and QR codes. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />

    <application
        android:name=".App"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/Theme.EarthWallet"
        android:networkSecurityConfig="@xml/network_security_config"
        android:pageSizeCompat="enabled"
        tools:targetApi="31">
    
        <!-- Launcher: checks Play for an update, then starts MainActivity. -->
        <activity
            android:name=".ui.UpdateCheckActivity"
            android:exported="true"
            android:theme="@style/Theme.EarthWallet"
            android:screenOrientation="portrait"
            android:launchMode="singleTop">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Referral links for someone who already has the app.
                 Installs come through the Play install referrer instead; see
                 referral/Referral.kt.

                 autoVerify needs /.well-known/assetlinks.json served from
                 erth.network. Without it these still work, but Android offers
                 a chooser rather than opening the app directly. -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="erth.network" android:pathPrefix="/ref" />
            </intent-filter>
            <!-- No custom scheme: one is unverified, so any page could fire
                 it and lock in its own referrer. -->
        </activity>

        <!-- ZXing Capture Activity with forced portrait orientation -->
        <activity
            android:name="com.journeyapps.barcodescanner.CaptureActivity"
            android:screenOrientation="portrait"
            android:stateNotNeeded="true"
            android:theme="@style/zxing_CaptureTheme"
            android:windowSoftInputMode="stateAlwaysHidden"
            tools:replace="android:screenOrientation" />

        <!-- exported="false": started only by UpdateCheckActivity, which is the
             launcher. It has no intent filter, so exporting it just let any
             installed app bring the wallet UI to the front. -->
        <activity
            android:name=".ui.MainActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:launchMode="singleTop"
            android:theme="@style/Theme.AppCompat.NoActionBar" />

        <activity
            android:name=".ui.registration.RegistrationActivity"
            android:exported="false"
            android:launchMode="singleTop"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden"
            android:theme="@style/Theme.AppCompat.NoActionBar" />

    </application>

</manifest>